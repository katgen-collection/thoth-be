# Template — copy to .env and fill in real values. Commit this file, NOT .env.

# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Use the Session pooler (port 5432) so SET search_path persists per connection.
# Alternatively set a single DATABASE_URL=postgres://...?sslmode=require to
# override all the DB_* parts below.
DB_HOST=aws-1-REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=postgres
DB_SSLMODE=require
# Service-specific schema to isolate tables in the shared Supabase Postgres.
# Leave empty to use the default (public).
SCHEMA_NAME=thoth-ai

# ─── Redis (asynq broker + pub/sub for SSE) — Upstash, TLS ───────────────────
# Upstash requires TLS — note the rediss:// scheme (double s).
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR-ENDPOINT.upstash.io:6379

# ─── AI ──────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Note: the scanned-PDF OCR fallback uses OpenRouter and is configured in the
# pdf-parser sidecar's own .env (OPENROUTER_API_KEY), not here.

# ─── External ────────────────────────────────────────────────────────────────
SERPAPI_KEY=YOUR_SERPAPI_KEY
# Google country code for job search. Without it Google geolocates to the US and
# city-scoped queries (e.g. "Jakarta") return zero results. Defaults to "id".
SERPAPI_GL=id

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003

# ─── File storage (S3-compatible: Cloudflare R2 / Supabase Storage / AWS S3) ──
# Endpoint is account-level ONLY — do NOT append the bucket name (path-style
# addressing adds it automatically). Blank = AWS default endpoint.
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
STORAGE_PRESIGN_TTL_SECONDS=300
MAX_CV_FILE_SIZE_MB=10
MAX_UPLOADS_PER_USER=50

# ─── pdf-parser service (loopback) ───────────────────────────────────────────
PDF_PARSER_URL=http://127.0.0.1:5001
