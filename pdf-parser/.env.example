# OpenRouter fallback (scanned/image-heavy PDFs). If unset, only pdfplumber runs.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers (shown on your OpenRouter dashboard).
OPENROUTER_REFERER=https://thothai.app
OPENROUTER_TITLE=Thothai PDF Parser

# Fallback model — carries the provider prefix. Swap freely to experiment
# (e.g. google/gemini-flash-1.5, qwen/qwen-2-vl-7b-instruct, mistralai/...).
PDF_FALLBACK_MODEL=openai/gpt-4o-mini
# PDF engine: native | mistral-ocr | pdf-text  (see main.py for the trade-offs)
PDF_OPENROUTER_ENGINE=native

# Bounds / tuning
PDF_MAX_PAGES=30
PDF_MAX_TEXT_CHARS=200000
PDF_MIN_TEXT_THRESHOLD=100
